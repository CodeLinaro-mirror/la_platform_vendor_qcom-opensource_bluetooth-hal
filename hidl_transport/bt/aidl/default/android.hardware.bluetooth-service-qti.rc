service vendor.bluetooth-qti /vendor/bin/hw/android.hardware.bluetooth-service-qti
    interface aidl android.hardware.bluetooth.IBluetoothHci/default
    class hal
    user bluetooth
    group bluetooth system wakelock oem_2901 net_raw oem_2912
    capabilities BLOCK_SUSPEND NET_ADMIN NET_ADMIN SYS_NICE
    task_profiles HighPerformance

service vendor.bluetooth-qti /vendor/bin/hw/android.hardware.bluetooth-service-qti
    interface aidl android.hardware.bluetooth.IBluetoothHci/default
    class hal
    user bluetooth
    group bluetooth system wakelock oem_2901 net_raw oem_2912 readtracefs
    capabilities BLOCK_SUSPEND NET_ADMIN NET_ADMIN SYS_NICE
    task_profiles MaxPerformance

on property:sys.boot_completed=1
    # Retry after system boot completed to handle late BT driver probe
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    chmod 0660 /sys/class/rfkill/rfkill0/state
